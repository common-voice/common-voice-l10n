### Navigation, menus and the language picker (new strings only).

## Navigation - names of the navigation landmarks, for screen readers only

# Header navigation bar accessibility/aria label
nav-primary-aria-label = Primary
# Navigation list inside the mobile menu, accessibility/aria label
nav-primary-mobile-aria-label = Primary mobile
# Second navigation bar, holding the actions of the current dataset type, accessibility/aria label
nav-secondary-aria-label = Dataset-type navigation
# Name of the mobile menu panel, read out when it opens; never shown on screen
primary-navigation-aria-label = Primary navigation

## Menu buttons - the icon buttons in the header, and the account menu

# Logo link to the home page, accessibility/aria label
home-aria-label = Home
# Button that opens the mobile menu, accessibility/aria label
open-menu-aria-label = Open menu
# Button that closes the mobile menu, accessibility/aria label
close-menu-aria-label = Close menu
# Name in the account menu when the person is not signed in
visitor = Visitor

## Menu entries - the links inside the header menus, each with a description under it

# Menu entry for the page listing every way to contribute
nav-overview = Overview
# Contribute menu button, accessibility/aria label
nav-contribute-aria-label = Contribute menu
# Datasets menu button, accessibility/aria label
nav-datasets-aria-label = Datasets menu
# About menu button, accessibility/aria label
nav-about-aria-label = About menu
# Description under the Overview entry
nav-contribute-overview-tagline = Pick a way to contribute and what each section is for.
# Menu entry linking to the dataset download site
nav-datasets-downloads = Downloads
# Menu entry linking to the form for asking that a dataset be added
nav-datasets-request = Request New Dataset
# Description under the Request New Dataset entry
nav-datasets-request-tagline = Ask for a new language or dataset to be added.
# Menu entry linking to the dataset progress figures
nav-datasets-statistics = Dataset statistics
# Description under the Dataset statistics entry
nav-datasets-statistics-tagline = Browse progress and stats across every dataset.

## Access - why an action in the dataset-type bar cannot be used yet

# Tooltip on a greyed-out action, when not signed in
nav-gate-anonymous = Sign in to use this action
# Tooltip on a greyed-out action, when the contribution score is too low
nav-gate-score = Earn more points to unlock this action
# Tooltip on a greyed-out action, when only dataset moderators may use it
nav-gate-role = Available to dataset moderators

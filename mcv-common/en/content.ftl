### Strings shared across contribution types and the guidelines popup (new strings only).

## Contribution flow - buttons and labels used by more than one contribution type

# Action in the dataset-type bar: speak an answer and record it. The verb, not the noun
record = Record

# Keyboard shortcut to open the report dialog (single letter; localizable)
content-report-shortcut = R

# Accessible name for the icon button that clears the current pick in a picker (dataset, variant)
clear-selection = Clear selection
# Accessible name for the remove-chip icon button; $name is the selected item's label (e.g. "Remove French")
remove-selection = Remove { $name }

## Guidelines popup - button, "I read and understood", link to full guidelines

# Confirm button in the first-visit guidelines dialog; clicking it dismisses the gate and records the acknowledgement
guidelines-understood = I read and understood

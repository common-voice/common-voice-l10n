### Shared UI strings (new strings only).

## Shell - the footer and the status line at the bottom of every page

# Connection state: the site can reach the server
connection-online = Online
# Connection state: the connection works but is slow or keeps dropping
connection-degraded = Unreliable
# Connection state: there is no connection
connection-offline = Offline

## Labels - small labels used on more than one page

# Button on the error page, to load the page again
retry-button = Reload page
# Shown on a page that is in the menus but not built yet
page-placeholder-note = This page is coming soon.

## Sign in - sign-in labels

## App updates - shown when a newer version of the site has been downloaded

# Heading of the popup offering the new version
update-available = Update available
# Body of the popup offering the new version. Common Voice is a product name
update-available-body = A new version of Common Voice is ready. Reload to use it.
# Button that loads the new version
update-reload = Reload
# Button that keeps the current version for now
update-later = Later

## News - news strip and news page

# Footer link to the news page
news = News

## Newsletter - the sign-up form in the footer

# Shown after the newsletter form is sent
newsletter-success = Thanks -- check your inbox to confirm.
# Shown when the form is sent without ticking the consent checkbox
newsletter-privacy-error = Please agree to the privacy notice first.

## Contribute - landing page and section overview

## Dataset types - the kinds of contribution, named in the Contribute menu

# Description under Scripted speech
ds-type-scs-tagline = Read short sentences out loud.
# Description under Spontaneous speech
ds-type-sps-tagline = Answer questions in your own words.
# Description under Code switching
ds-type-cs-tagline = Speak across two languages in one turn.
# Dataset type where people reply to each other over time, not in a live call
ds-type-acr-name = Asynchronous Conversations
# Description under Asynchronous Conversations
ds-type-acr-tagline = Reply to others in moderated, topic-bound rooms.

## Dataset picker - choosing which dataset to contribute to

# Trigger text before a dataset is chosen
dataset-picker-placeholder = Select a dataset
# Search field inside the dataset picker
dataset-picker-search = Search datasets

## Dataset request - asking for a dataset that does not exist yet

# Page title: asking for a new dataset, which may or may not be a new language
request-dataset = Request a dataset
# Page title shown after a dataset request has been sent
request-dataset-success = Request received

## Legal documents - privacy notice and terms, authored outside Common Voice

# Shown while a legal document is being fetched
document-loading = Loading the document...
# Shown when a legal document cannot be fetched
document-error = This document could not be loaded. Please try again later.
# Precedes the list of languages a legal document is shown in when the reader's own is unavailable
document-fallback-lead = This document has not been translated into your language yet. It is shown in:
